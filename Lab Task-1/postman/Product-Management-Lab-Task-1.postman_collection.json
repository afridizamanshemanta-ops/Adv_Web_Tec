{
  "info": {
    "name": "NestJS Lab Task 1 - Product & Employee CRUD",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "productId",
      "value": "1"
    },
    {
      "key": "employeeId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Products",
      "item": [
        {
          "name": "01 Create Product 1",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/products",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Wireless Mouse\",\n  \"category\": \"Electronics\",\n  \"price\": 850,\n  \"quantity\": 25\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "02 Create Product 2",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/products",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"USB Keyboard\",\n  \"category\": \"Electronics\",\n  \"price\": 1200,\n  \"quantity\": 15\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "03 Get All Products",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/products"
          }
        },
        {
          "name": "04 Get Product By ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/products/{{productId}}"
          }
        },
        {
          "name": "05 Update Product",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/products/{{productId}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 900,\n  \"quantity\": 20\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "06 Confirm Product Update",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/products/{{productId}}"
          }
        },
        {
          "name": "07 Delete Product",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/products/{{productId}}"
          }
        },
        {
          "name": "08 Confirm Product Deleted",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/products"
          }
        }
      ]
    },
    {
      "name": "Employees",
      "item": [
        {
          "name": "01 Create Employee",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/employees",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rahim Ahmed\",\n  \"email\": \"rahim@example.com\",\n  \"phone\": \"01700000000\",\n  \"password\": \"demo1234\",\n  \"age\": 25,\n  \"yearsOfWorking\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "02 Get All Employees",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/employees"
          }
        },
        {
          "name": "03 Get Employee By ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/employees/{{employeeId}}"
          }
        },
        {
          "name": "04 Update Employee",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/employees/{{employeeId}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"01800000000\",\n  \"yearsOfWorking\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "05 Delete Employee",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/employees/{{employeeId}}"
          }
        }
      ]
    }
  ]
}